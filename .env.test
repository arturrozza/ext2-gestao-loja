# Loaded on top of .env by the server test scripts.
DATABASE_URL=postgres://ext2:ext2@localhost:5432/ext2_test
# Tests pass the master password explicitly; the seed is exercised by its own test.
MASTER_PASSWORD=
SEED_STORE_NAME=
SEED_USER_NAME=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=
# Photos off: tests swap in an in-memory storage (test/support/photo-storage.ts), never the real bucket.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
PHOTOS_PUBLIC_URL=
