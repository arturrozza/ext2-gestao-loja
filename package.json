{
	"name": "ext2",
	"private": true,
	"packageManager": "bun@1.4.2",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"@elysia/eden": "^1.4.10",
			"@sinclair/typebox": "^0.34.52",
			"@types/bun": "^1.4.3",
			"elysia": "^1.4.30",
			"file-type": "^22.2.0",
			"openapi-types": "^12.1.3",
			"typescript": "~6.0.3",
			"zod": "^4.6.7"
		}
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"husky": "^9.1.7"
	},
	"scripts": {
		"prepare": "husky",
		"format": "biome format --write",
		"lint": "biome lint",
		"check": "biome check",
		"check:fix": "biome check --write",
		"typecheck": "bun --filter '*' typecheck",
		"test": "bun --filter @ext2/server test",
		"dev:server": "bun --filter @ext2/server dev",
		"dev:mobile": "bun --filter @ext2/mobile start",
		"db:up": "docker compose up -d --wait postgres",
		"up": "docker compose up -d --wait --build",
		"down": "docker compose down"
	}
}
