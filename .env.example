# Postgres (docker compose)
POSTGRES_USER=ext2
POSTGRES_PASSWORD=ext2
POSTGRES_DB=ext2

# Server
PORT=3000
DATABASE_URL=postgres://ext2:ext2@localhost:5432/ext2
# Signs in as any user (support). Leave empty to disable; at least 16 characters.
MASTER_PASSWORD=
# First store and user, created by the migrate step while there's no user (all four or none).
SEED_STORE_NAME=Mundo Madam
SEED_USER_NAME=Dono
SEED_USER_EMAIL=teste@teste.com
SEED_USER_PASSWORD=12345678

# Mobile — EXPO_PUBLIC_* is inlined into the app bundle: never put secrets here.
# On a physical device, use your machine's LAN IP instead of localhost.
EXPO_PUBLIC_API_URL=http://192.168.0.13:3000
