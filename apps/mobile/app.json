{
	"expo": {
		"name": "MM Vendas",
		"slug": "mobile",
		"version": "1.2.0",
		"orientation": "portrait",
		"icon": "./assets/images/icon.png",
		"scheme": "mundomadam",
		"userInterfaceStyle": "light",
		"ios": {
			"bundleIdentifier": "com.mundomadam.loja",
			"config": {
				"usesNonExemptEncryption": false
			}
		},
		"android": {
			"package": "com.mundomadam.loja",
			"adaptiveIcon": {
				"backgroundColor": "#EA580C",
				"foregroundImage": "./assets/images/android-icon-foreground.png",
				"monochromeImage": "./assets/images/android-icon-monochrome.png"
			},
			"predictiveBackGestureEnabled": false
		},
		"web": {
			"output": "static",
			"favicon": "./assets/images/favicon.png",
			"bundler": "metro"
		},
		"plugins": [
			"expo-router",
			[
				"expo-splash-screen",
				{
					"backgroundColor": "#EA580C",
					"image": "./assets/images/splash-icon.png",
					"imageWidth": 200
				}
			],
			"expo-font",
			"expo-image",
			"expo-status-bar",
			"expo-web-browser",
			[
				"expo-image-picker",
				{
					"photosPermission": "O app usa suas fotos para colocar a foto do produto.",
					"cameraPermission": "O app usa a câmera para tirar a foto do produto e ler o código de barras.",
					"microphonePermission": false
				}
			],
			[
				"expo-camera",
				{
					"cameraPermission": "O app usa a câmera para tirar a foto do produto e ler o código de barras.",
					"recordAudioAndroid": false
				}
			],
			"@react-native-community/datetimepicker",
			"expo-secure-store",
			[
				"expo-notifications",
				{
					"icon": "./assets/images/notification-icon.png",
					"color": "#EA580C"
				}
			]
		],
		"experiments": {
			"typedRoutes": true,
			"reactCompiler": true
		},
		"extra": {
			"router": {},
			"eas": {
				"projectId": "27fd535e-5b5d-43b0-97cb-da8bd3ec2981"
			}
		},
		"owner": "mundo-madam",
		"runtimeVersion": {
			"policy": "appVersion"
		},
		"updates": {
			"url": "https://u.expo.dev/27fd535e-5b5d-43b0-97cb-da8bd3ec2981"
		}
	}
}
